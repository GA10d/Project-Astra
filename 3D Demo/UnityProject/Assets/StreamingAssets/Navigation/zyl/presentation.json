  "escapeEncouragement": [
    {
      "text": "抓紧，我来带路！",
      "duration": 8,
      "replies": [],
      "timerKey": "timer_mw5zq1ws_dad5fxf4g5",
      "timerAction": null,
      "replyTimerActions": []
    },
    {
      "text": "跟着我的航线，别担心！",
      "duration": 8,
      "replies": [],
      "timerKey": "timer_mw5zq1ws_38jx8wedvp",
      "timerAction": null,
      "replyTimerActions": []
    },
    {
      "text": "前面有障碍，我来撞开！",
      "duration": 8,
      "replies": [],
      "timerKey": "timer_mw5zq1ws_pioe0l8dye",
      "timerAction": null,
      "replyTimerActions": []
    },
    {
      "text": "还撑得住，我们继续！",
      "duration": 8,
      "replies": [],
      "timerKey": "timer_mw5zq1ws_q4ulde42bt",
      "timerAction": null,
      "replyTimerActions": []
    },
    {
      "text": "就快到出口了，坚持住！",
      "duration": 8,
      "replies": [],
      "timerKey": "timer_mw5zq1ws_r1lickwgrp",
      "timerAction": null,
      "replyTimerActions": []
    },
    {
      "text": "看到亮光了，我们能出去！",
      "duration": 8,
      "replies": [],
      "timerKey": "timer_mw5zq1ws_hzqd9f7ww4",
      "timerAction": null,
      "replyTimerActions": []
    },
    {
      "text": "最后一段路，抓稳！",
      "duration": 8,
      "replies": [],
      "timerKey": "timer_mw5zq1ws_od5ytmjzgb",
      "timerAction": null,
      "replyTimerActions": []
    }
  ],
  "farewellChestDuration": 4,
